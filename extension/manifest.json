{
  "manifest_version": 3,
  "name": "Browser Controls Agent",
  "version": "0.1.0",
  "description": "Control and inspect Chrome tabs through local WebSocket agent.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "webRequest",
    "debugger"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Controls Agent"
  }
}